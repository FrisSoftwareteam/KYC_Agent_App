# Copy this file to .env (same folder) before building. .env is never committed.
# Live API (note the slash at the end)
API_URL=https://firstcheckapi.firstregistrarsnigeria.com/v1/
# Ably: the SUBSCRIBE-ONLY key from the company's "First check kyc" Ably app (starts 70A3og.)
# Never use the API-server or root key here - anything in the app can be read by whoever has the phone.
ABLY_KEY=
# Agents must be within this many metres of the address to submit a visit
DISTANCE=100
